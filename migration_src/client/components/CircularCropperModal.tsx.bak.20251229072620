import React, { useEffect, useMemo, useRef, useState } from "react";
import { Modal, View, Text, StyleSheet, TouchableOpacity, Image, LayoutChangeEvent, PanResponder } from "react-native";
import * as ImageManipulator from "expo-image-manipulator";

/**
 * Circular crop overlay editor (Phase 2.1):
 * - Shows a clear circular guide (no dimming)
 * - Allows drag to position
 * - Allows zoom via +/- buttons (simple + reliable)
 * - Outputs a square-cropped image; displayed as circle elsewhere
 *
 * NOTE: This intentionally avoids complex pinch logic for stability.
 */

export type CircularCropperModalProps = {
  visible: boolean;
  uri: string | null;
  title?: string;
  onCancel: () => void;
  onDone: (resultUri: string) => void;
};

type ImgSize = { w: number; h: number };

export default function CircularCropperModal({ visible, uri, title, onCancel, onDone }: CircularCropperModalProps) {
  const [frame, setFrame] = useState(280); // square editor size (px) – will snap to measured width
  const [imgSize, setImgSize] = useState<ImgSize | null>(null);

  // User-controlled transform
  const [userScale, setUserScale] = useState(1);
  const [tx, setTx] = useState(0);
  const [ty, setTy] = useState(0);

  // For dragging
  const dragStart = useRef({ x: 0, y: 0 });

  useEffect(() => {
    if (!uri) return;
    Image.getSize(
      uri,
      (w, h) => setImgSize({ w, h }),
      () => setImgSize(null)
    );
  }, [uri]);

  // Reset when opened/new uri
  useEffect(() => {
    if (!visible) return;
    setUserScale(1);
    setTx(0);
    setTy(0);
  }, [visible, uri]);

  const baseScale = useMemo(() => {
    if (!imgSize) return 1;
    // cover the square frame
    return Math.max(frame / imgSize.w, frame / imgSize.h);
  }, [imgSize, frame]);

  const effectiveScale = baseScale * userScale;

  const clampTranslation = (nextTx: number, nextTy: number) => {
    if (!imgSize) return { x: nextTx, y: nextTy };
    const scaledW = imgSize.w * effectiveScale;
    const scaledH = imgSize.h * effectiveScale;

    // image is centered; allow moving within bounds so the image always covers the frame
    const maxX = Math.max(0, (scaledW - frame) / 2);
    const maxY = Math.max(0, (scaledH - frame) / 2);

    const x = Math.max(-maxX, Math.min(maxX, nextTx));
    const y = Math.max(-maxY, Math.min(maxY, nextTy));
    return { x, y };
  };

  const panResponder = useMemo(
    () =>
      PanResponder.create({
        onMoveShouldSetPanResponder: () => true,
        onPanResponderGrant: () => {
          dragStart.current = { x: tx, y: ty };
        },
        onPanResponderMove: (_evt, gesture) => {
          const next = clampTranslation(dragStart.current.x + gesture.dx, dragStart.current.y + gesture.dy);
          setTx(next.x);
          setTy(next.y);
        },
      }),
    // eslint-disable-next-line react-hooks/exhaustive-deps
    [tx, ty, imgSize, effectiveScale, frame]
  );

  const onLayoutFrame = (e: LayoutChangeEvent) => {
    const w = e.nativeEvent.layout.width;
    if (w && Math.abs(w - frame) > 2) setFrame(Math.round(w));
  };

  const zoomBy = (delta: number) => {
    const nextScale = Math.max(1, Math.min(3, +(userScale + delta).toFixed(2)));
    setUserScale(nextScale);
    const next = clampTranslation(tx, ty);
    setTx(next.x);
    setTy(next.y);
  };

  const handleDone = async () => {
    if (!uri || !imgSize) return;

    // Compute crop rect in original image coordinates
    const cropSize = frame / effectiveScale;

    const originX = imgSize.w / 2 - cropSize / 2 - tx / effectiveScale;
    const originY = imgSize.h / 2 - cropSize / 2 - ty / effectiveScale;

    const safe = {
      originX: Math.max(0, Math.min(imgSize.w - cropSize, originX)),
      originY: Math.max(0, Math.min(imgSize.h - cropSize, originY)),
      width: Math.min(imgSize.w, cropSize),
      height: Math.min(imgSize.h, cropSize),
    };

    try {
      const result = await ImageManipulator.manipulateAsync(uri, [{ crop: safe }], {
        compress: 0.85,
        format: ImageManipulator.SaveFormat.JPEG,
      });
      onDone(result.uri);
    } catch {
      onDone(uri);
    }
  };

  return (
    <Modal visible={visible} animationType="slide" presentationStyle="pageSheet" onRequestClose={onCancel}>
      <View style={styles.container}>
        <View style={styles.header}>
          <TouchableOpacity onPress={onCancel} hitSlop={10}>
            <Text style={styles.headerLink}>Back</Text>
          </TouchableOpacity>

          <Text style={styles.headerTitle}>{title ?? "Position your photo"}</Text>

          <TouchableOpacity onPress={handleDone} hitSlop={10}>
            <Text style={styles.headerLink}>Done</Text>
          </TouchableOpacity>
        </View>

        <View style={styles.stage}>
          <View style={styles.frameWrap} onLayout={onLayoutFrame}>
            <View style={styles.frame} {...panResponder.panHandlers}>
              {uri ? (
                <Image
                  source={{ uri }}
                  style={[
                    styles.image,
                    {
                      width: imgSize ? imgSize.w * effectiveScale : frame,
                      height: imgSize ? imgSize.h * effectiveScale : frame,
                      transform: [{ translateX: tx }, { translateY: ty }],
                    },
                  ]}
                />
              ) : (
                <View style={styles.empty}>
                  <Text style={styles.emptyText}>No photo selected</Text>
                </View>
              )}

              {/* Circle guide overlay (no dimming) */}
              <View pointerEvents="none" style={styles.circleGuideWrap}>
                <View style={[styles.circleGuide, { width: frame, height: frame, borderRadius: frame / 2 }]} />
              </View>
            </View>
          </View>

          <View style={styles.controls}>
            <TouchableOpacity onPress={() => zoomBy(-0.12)} style={styles.zoomBtn}>
              <Text style={styles.zoomText}>−</Text>
            </TouchableOpacity>
            <Text style={styles.zoomLabel}>Zoom</Text>
            <TouchableOpacity onPress={() => zoomBy(+0.12)} style={styles.zoomBtn}>
              <Text style={styles.zoomText}>+</Text>
            </TouchableOpacity>
          </View>

          <Text style={styles.hint}>Drag to position. Use + / − to zoom.</Text>
        </View>
      </View>
    </Modal>
  );
}

const styles = StyleSheet.create({
  container: { flex: 1, backgroundColor: "#FFFFFF" },

  header: {
    paddingTop: 18,
    paddingHorizontal: 16,
    paddingBottom: 10,
    borderBottomWidth: StyleSheet.hairlineWidth,
    borderBottomColor: "#E5E7EB",
    flexDirection: "row",
    alignItems: "center",
    justifyContent: "space-between",
  },
  headerTitle: { fontSize: 18, fontWeight: "900", color: "#111827", flex: 1, textAlign: "center" },
  headerLink: { fontSize: 16, fontWeight: "900", color: "#111827" },

  stage: { flex: 1, padding: 16, alignItems: "center", justifyContent: "center", gap: 12 },

  frameWrap: { width: "100%", maxWidth: 340, alignSelf: "center" },
  frame: {
    width: "100%",
    aspectRatio: 1,
    borderRadius: 16,
    backgroundColor: "#0B0F1A",
    overflow: "hidden",
    alignItems: "center",
    justifyContent: "center",
  },

  image: {
    position: "absolute",
    // center the image (we translate from center via tx/ty, so keep it centered)
    left: "50%",
    top: "50%",
    marginLeft: -9999,
    marginTop: -9999,
  },

  empty: { width: "100%", height: "100%", alignItems: "center", justifyContent: "center" },
  emptyText: { color: "#E5E7EB", fontWeight: "800" },

  circleGuideWrap: {
    position: "absolute",
    left: 0,
    right: 0,
    top: 0,
    bottom: 0,
    alignItems: "center",
    justifyContent: "center",
  },
  circleGuide: {
    borderWidth: 3,
    borderColor: "#FFFFFF",
    backgroundColor: "transparent",
  },

  controls: { flexDirection: "row", alignItems: "center", gap: 12, marginTop: 10 },
  zoomBtn: {
    width: 42,
    height: 42,
    borderRadius: 21,
    borderWidth: StyleSheet.hairlineWidth,
    borderColor: "#D1D5DB",
    backgroundColor: "#FFFFFF",
    alignItems: "center",
    justifyContent: "center",
  },
  zoomText: { fontSize: 22, fontWeight: "900", color: "#111827", marginTop: -2 },
  zoomLabel: { fontSize: 13, fontWeight: "800", color: "#6B7280" },

  hint: { fontSize: 13, color: "#6B7280", fontWeight: "700" },
});

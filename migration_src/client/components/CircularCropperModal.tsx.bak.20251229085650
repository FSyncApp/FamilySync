import React, { useEffect, useMemo, useRef, useState } from "react";
import {
  Modal,
  View,
  Text,
  StyleSheet,
  TouchableOpacity,
  Image,
  LayoutChangeEvent,
  PanResponder,
  Dimensions,
  Platform,
  SafeAreaView,
} from "react-native";
import * as ImageManipulator from "expo-image-manipulator";

/**
 * Circular crop overlay editor (Phase 2.1):
 * - Shows a circular guide (no dimming)
 * - Drag to position (single finger)
 * - Zoom via +/- buttons (stable)
 * - Crops a square output that will be displayed as a circle elsewhere
 *
 * IMPORTANT: iOS Photo Library can return "ph://..." URIs, which RN <Image> can't render.
 * We "materialize" those into a file:// URI using ImageManipulator with a no-op operation.
 *
 * NOTE: Use fullScreen presentation on iOS to avoid sheet swipe-to-dismiss interfering with drag gestures.
 */

export type CircularCropperModalProps = {
  visible: boolean;
  uri: string | null;
  title?: string;
  onCancel: () => void;
  onDone: (resultUri: string) => void;
};

type ImgSize = { w: number; h: number };

function isPhUri(u: string) {
  return u.startsWith("ph://") || u.startsWith("assets-library://");
}

async function materializeUri(inputUri: string): Promise<string> {
  if (!isPhUri(inputUri)) return inputUri;
  const out = await ImageManipulator.manipulateAsync(inputUri, [], {
    compress: 1,
    format: ImageManipulator.SaveFormat.JPEG,
  });
  return out.uri || inputUri;
}

export default function CircularCropperModal({
  visible,
  uri,
  title = "Position your photo",
  onCancel,
  onDone,
}: CircularCropperModalProps) {
  const win = Dimensions.get("window");

  // Square editor size (px). Start based on screen width; updated by onLayout.
  const initialFrame = Math.min(win.width - 48, 360);
  const [frame, setFrame] = useState(initialFrame);

  const [imgSize, setImgSize] = useState<ImgSize | null>(null);
  const [sourceUri, setSourceUri] = useState<string | null>(null);

  // User-controlled zoom + translation (in px relative to frame center)
  const [userScale, setUserScale] = useState(1);
  const [tx, setTx] = useState(0);
  const [ty, setTy] = useState(0);

  const dragStart = useRef({ x: 0, y: 0 });

  // Materialize (ph:// -> file://) when opening / uri changes
  useEffect(() => {
    let cancelled = false;

    async function run() {
      if (!uri || !visible) {
        setSourceUri(null);
        return;
      }

      try {
        const out = await materializeUri(uri);
        if (!cancelled) setSourceUri(out);
      } catch {
        if (!cancelled) setSourceUri(uri);
      }
    }

    run();
    return () => {
      cancelled = true;
    };
  }, [uri, visible]);

  // Load image dimensions
  useEffect(() => {
    if (!sourceUri) return;
    Image.getSize(
      sourceUri,
      (w, h) => setImgSize({ w, h }),
      () => setImgSize(null)
    );
  }, [sourceUri]);

  // Reset when opened/new uri
  useEffect(() => {
    if (!visible) return;
    setUserScale(1);
    setTx(0);
    setTy(0);
  }, [visible, sourceUri]);

  // Base scale ensures the image always covers the square frame.
  const baseScale = useMemo(() => {
    if (!imgSize) return 1;
    return Math.max(frame / imgSize.w, frame / imgSize.h);
  }, [imgSize, frame]);

  const effectiveScale = baseScale * userScale;

  // Rendered pixel size of the image in the editor.
  const rendered = useMemo(() => {
    if (!imgSize) return { w: frame, h: frame };
    return {
      w: imgSize.w * effectiveScale,
      h: imgSize.h * effectiveScale,
    };
  }, [imgSize, effectiveScale, frame]);

  // Clamp translation so image always covers the frame (no empty edges).
  const clampTranslation = (nextTx: number, nextTy: number) => {
    if (!imgSize) return { x: nextTx, y: nextTy };

    const maxX = Math.max(0, (rendered.w - frame) / 2);
    const maxY = Math.max(0, (rendered.h - frame) / 2);

    const x = Math.max(-maxX, Math.min(maxX, nextTx));
    const y = Math.max(-maxY, Math.min(maxY, nextTy));
    return { x, y };
  };

  const panResponder = useMemo(
    () =>
      PanResponder.create({
        onStartShouldSetPanResponder: () => true,
        onMoveShouldSetPanResponder: () => true,
        onPanResponderGrant: () => {
          dragStart.current = { x: tx, y: ty };
        },
        onPanResponderMove: (_evt, gesture) => {
          const next = clampTranslation(dragStart.current.x + gesture.dx, dragStart.current.y + gesture.dy);
          setTx(next.x);
          setTy(next.y);
        },
      }),
    // eslint-disable-next-line react-hooks/exhaustive-deps
    [tx, ty, rendered.w, rendered.h, frame, imgSize]
  );

  const onLayoutFrame = (e: LayoutChangeEvent) => {
    const w = Math.round(e.nativeEvent.layout.width);
    if (w && Math.abs(w - frame) > 2) setFrame(w);
  };

  const zoomBy = (delta: number) => {
    const nextScale = Math.max(1, Math.min(3, +(userScale + delta).toFixed(2)));
    setUserScale(nextScale);
    const next = clampTranslation(tx, ty);
    setTx(next.x);
    setTy(next.y);
  };

  const handleDone = async () => {
    if (!sourceUri || !imgSize) return;

    const cropSize = frame / effectiveScale;
    const originX = imgSize.w / 2 - cropSize / 2 - tx / effectiveScale;
    const originY = imgSize.h / 2 - cropSize / 2 - ty / effectiveScale;

    const safe = {
      originX: Math.max(0, Math.min(imgSize.w - cropSize, originX)),
      originY: Math.max(0, Math.min(imgSize.h - cropSize, originY)),
      width: Math.min(imgSize.w, cropSize),
      height: Math.min(imgSize.h, cropSize),
    };

    try {
      const result = await ImageManipulator.manipulateAsync(sourceUri, [{ crop: safe }], {
        compress: 0.9,
        format: ImageManipulator.SaveFormat.JPEG,
      });
      onDone(result.uri);
    } catch {
      onDone(sourceUri);
    }
  };

  // Circle guide size should be relative to the editor frame, not the window.
  const circleSize = Math.round(frame * 0.82);

  return (
    <Modal
      visible={visible}
      animationType="slide"
      presentationStyle={Platform.OS === "ios" ? "fullScreen" : "fullScreen"}
      onRequestClose={onCancel}
    >
      <SafeAreaView style={styles.safe}>
        <View style={styles.container}>
          <View style={styles.header}>
            <TouchableOpacity onPress={onCancel} hitSlop={12}>
              <Text style={styles.headerLink}>Back</Text>
            </TouchableOpacity>

            <Text style={styles.headerTitle}>{title}</Text>

            <TouchableOpacity onPress={handleDone} hitSlop={12}>
              <Text style={styles.headerLink}>Done</Text>
            </TouchableOpacity>
          </View>

          <View style={styles.body}>
            <View style={styles.frameWrap} onLayout={onLayoutFrame}>
              <View style={styles.frame} {...panResponder.panHandlers}>
                {!!sourceUri && !!imgSize && (
                  <Image
                    source={{ uri: sourceUri }}
                    style={[
                      styles.image,
                      {
                        width: rendered.w,
                        height: rendered.h,
                        left: (frame - rendered.w) / 2 + tx,
                        top: (frame - rendered.h) / 2 + ty,
                      },
                    ]}
                    resizeMode="cover"
                  />
                )}
              </View>

              {/* Circle guide overlay (no dimming) */}
              <View pointerEvents="none" style={styles.circleGuideWrap}>
                <View style={[styles.circleGuide, { width: circleSize, height: circleSize, borderRadius: circleSize / 2 }]} />
              </View>
            </View>

            <View style={styles.controls}>
              <TouchableOpacity style={styles.zoomBtn} onPress={() => zoomBy(-0.1)} hitSlop={10}>
                <Text style={styles.zoomBtnText}>−</Text>
              </TouchableOpacity>
              <Text style={styles.zoomLabel}>Zoom</Text>
              <TouchableOpacity style={styles.zoomBtn} onPress={() => zoomBy(0.1)} hitSlop={10}>
                <Text style={styles.zoomBtnText}>+</Text>
              </TouchableOpacity>
            </View>

            <Text style={styles.hint}>Drag to position. Use + / − to zoom.</Text>
          </View>
        </View>
      </SafeAreaView>
    </Modal>
  );
}

const styles = StyleSheet.create({
  safe: { flex: 1, backgroundColor: "#FFFFFF" },
  container: { flex: 1, backgroundColor: "#FFFFFF" },

  header: {
    paddingHorizontal: 16,
    paddingTop: Platform.OS === "ios" ? 8 : 10,
    paddingBottom: 10,
    flexDirection: "row",
    alignItems: "flex-end",
    justifyContent: "space-between",
    borderBottomWidth: StyleSheet.hairlineWidth,
    borderBottomColor: "#E5E7EB",
  },
  headerLink: { fontSize: 20, fontWeight: "800", color: "#111827" },
  headerTitle: { fontSize: 22, fontWeight: "900", color: "#111827" },

  body: { flex: 1, alignItems: "center", justifyContent: "center", paddingHorizontal: 16 },

  frameWrap: {
    width: "100%",
    maxWidth: 360,
    aspectRatio: 1,
    borderRadius: 18,
    backgroundColor: "#0B1220",
    overflow: "hidden",
    alignItems: "center",
    justifyContent: "center",
  },
  frame: {
    width: "100%",
    height: "100%",
    overflow: "hidden",
  },
  image: {
    position: "absolute",
  },

  circleGuideWrap: {
    position: "absolute",
    left: 0,
    top: 0,
    right: 0,
    bottom: 0,
    alignItems: "center",
    justifyContent: "center",
  },
  circleGuide: {
    borderWidth: 3,
    borderColor: "rgba(255,255,255,0.95)",
  },

  controls: {
    marginTop: 18,
    flexDirection: "row",
    alignItems: "center",
    gap: 16,
  },
  zoomBtn: {
    width: 54,
    height: 54,
    borderRadius: 27,
    alignItems: "center",
    justifyContent: "center",
    backgroundColor: "#F3F4F6",
    borderWidth: StyleSheet.hairlineWidth,
    borderColor: "#E5E7EB",
  },
  zoomBtnText: { fontSize: 28, fontWeight: "900", color: "#111827", marginTop: -2 },
  zoomLabel: { fontSize: 20, fontWeight: "900", color: "#111827" },

  hint: { marginTop: 12, fontSize: 14, color: "#6B7280" },
});

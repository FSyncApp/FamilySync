import React, { useEffect, useMemo, useRef, useState } from "react";
import {
  Modal,
  View,
  Text,
  StyleSheet,
  TouchableOpacity,
  Image,
  LayoutChangeEvent,
  PanResponder,
} from "react-native";
import * as ImageManipulator from "expo-image-manipulator";

/**
 * Phase 2.1 — Patch A
 * - Remove overlay artifacts ("star") by using even geometry + tiny overlaps
 * - Loosen drag/zoom constraints by clamping to the CIRCLE bounds (not the full square editor)
 * - Keep pinch zoom + drag (no extra deps)
 * - Crop result to the circle bounding square (so corners can never go blank)
 */

export type CircularCropperModalProps = {
  visible: boolean;
  uri: string | null;
  title?: string;
  onCancel: () => void;
  onDone: (resultUri: string) => void;
};

type ImgSize = { w: number; h: number };

function clamp(n: number, min: number, max: number) {
  return Math.max(min, Math.min(max, n));
}

function makeEven(n: number) {
  const i = Math.round(n);
  return i % 2 === 0 ? i : i - 1;
}

export default function CircularCropperModal({ visible, uri, title, onCancel, onDone }: CircularCropperModalProps) {
  const [frame, setFrame] = useState(300);
  const [imgSize, setImgSize] = useState<ImgSize | null>(null);

  const [userScale, setUserScale] = useState(1);
  const [tx, setTx] = useState(0);
  const [ty, setTy] = useState(0);

  const dragStart = useRef({ x: 0, y: 0 });
  const pinchStart = useRef({ dist: 0, scale: 1 });

  useEffect(() => {
    if (!uri) return;
    Image.getSize(
      uri,
      (w, h) => setImgSize({ w, h }),
      () => setImgSize(null)
    );
  }, [uri]);

  useEffect(() => {
    if (!visible) return;
    setUserScale(1);
    setTx(0);
    setTy(0);
    pinchStart.current = { dist: 0, scale: 1 };
  }, [visible, uri]);

  // Circle bounding box size (even -> avoids seams)
  const hole = useMemo(() => {
    // 0.82 chosen earlier; keep but enforce even pixel size
    return Math.max(220, makeEven(frame * 0.82));
  }, [frame]);

  const radius = hole / 2;

  const baseScale = useMemo(() => {
    if (!imgSize) return 1;
    // IMPORTANT: cover the circle bounding square, not the entire editor
    return Math.max(hole / imgSize.w, hole / imgSize.h);
  }, [imgSize, hole]);

  const effectiveScale = baseScale * userScale;

  const clampTranslation = (nextTx: number, nextTy: number, effScale: number = effectiveScale) => {
    if (!imgSize) return { x: nextTx, y: nextTy };

    // Clamp so the scaled image always covers the CIRCLE bounding square (hole)
    const scaledW = imgSize.w * effScale;
    const scaledH = imgSize.h * effScale;

    const maxX = Math.max(0, (scaledW - hole) / 2);
    const maxY = Math.max(0, (scaledH - hole) / 2);

    return {
      x: clamp(nextTx, -maxX, maxX),
      y: clamp(nextTy, -maxY, maxY),
    };
  };

  const panResponder = useMemo(
    () =>
      PanResponder.create({
        onStartShouldSetPanResponder: () => true,
        onStartShouldSetPanResponderCapture: () => true,
        onMoveShouldSetPanResponder: () => true,
        onMoveShouldSetPanResponderCapture: () => true,
        onPanResponderTerminationRequest: () => false,
        onPanResponderGrant: (evt) => {
          dragStart.current = { x: tx, y: ty };
          const touches = evt.nativeEvent.touches ?? [];
          if (touches.length === 2) {
            const [a, b] = touches;
            const dx = a.pageX - b.pageX;
            const dy = a.pageY - b.pageY;
            pinchStart.current = { dist: Math.hypot(dx, dy), scale: userScale };
          } else {
            pinchStart.current = { dist: 0, scale: userScale };
          }
        },
        onPanResponderMove: (evt, gesture) => {
          const touches = evt.nativeEvent.touches ?? [];

          if (touches.length === 2) {
            const [a, b] = touches;
            const dx = a.pageX - b.pageX;
            const dy = a.pageY - b.pageY;
            const dist = Math.hypot(dx, dy);

            if (!pinchStart.current.dist) {
              pinchStart.current = { dist, scale: userScale };
              return;
            }

            const ratio = dist / pinchStart.current.dist;
            const nextUserScale = clamp(pinchStart.current.scale * ratio, 1, 4);
            const nextEff = baseScale * nextUserScale;

            setUserScale(nextUserScale);

            const next = clampTranslation(tx, ty, nextEff);
            setTx(next.x);
            setTy(next.y);
            return;
          }

          const next = clampTranslation(dragStart.current.x + gesture.dx, dragStart.current.y + gesture.dy);
          setTx(next.x);
          setTy(next.y);
        },
      }),
    // eslint-disable-next-line react-hooks/exhaustive-deps
    [tx, ty, userScale, imgSize, effectiveScale, hole, baseScale]
  );

  const onLayoutFrame = (e: LayoutChangeEvent) => {
    const w = Math.round(e.nativeEvent.layout.width);
    if (w && Math.abs(w - frame) > 2) setFrame(w);
  };

  const zoomBy = (delta: number) => {
    const nextUserScale = clamp(+(userScale + delta).toFixed(2), 1, 4);
    const nextEff = baseScale * nextUserScale;
    setUserScale(nextUserScale);
    const next = clampTranslation(tx, ty, nextEff);
    setTx(next.x);
    setTy(next.y);
  };

  const handleDone = async () => {
    if (!uri || !imgSize) return;

    // Crop to the circle's bounding square (hole), mapped back to original image
    const cropSize = hole / effectiveScale;

    const originX = imgSize.w / 2 - cropSize / 2 - tx / effectiveScale;
    const originY = imgSize.h / 2 - cropSize / 2 - ty / effectiveScale;

    const safe = {
      originX: Math.max(0, Math.min(imgSize.w - cropSize, originX)),
      originY: Math.max(0, Math.min(imgSize.h - cropSize, originY)),
      width: Math.min(imgSize.w, cropSize),
      height: Math.min(imgSize.h, cropSize),
    };

    try {
      const result = await ImageManipulator.manipulateAsync(
        uri,
        [{ crop: safe }],
        { compress: 0.85, format: ImageManipulator.SaveFormat.JPEG }
      );
      onDone(result.uri);
    } catch {
      onDone(uri);
    }
  };

  // Overlay geometry derived from even hole
  const side = Math.round((frame - hole) / 2);
  const q = hole / 2;

  // 1px overlap avoids seams on odd device scales
  const O = 1;

  return (
    <Modal visible={visible} animationType="slide" presentationStyle="pageSheet" onRequestClose={onCancel}>
      <View style={styles.container}>
        <View style={styles.header}>
          <TouchableOpacity onPress={onCancel} hitSlop={10}>
            <Text style={styles.headerLink}>Cancel</Text>
          </TouchableOpacity>
          <Text style={styles.headerTitle}>{title ?? "Position your photo"}</Text>
          <TouchableOpacity onPress={handleDone} hitSlop={10}>
            <Text style={styles.headerLink}>Done</Text>
          </TouchableOpacity>
        </View>

        <View style={styles.editorWrap}>
          <View style={styles.editor} onLayout={onLayoutFrame} {...panResponder.panHandlers}>
            {uri ? (
              <Image
                source={{ uri }}
                style={[
                  styles.image,
                  {
                    width: imgSize ? imgSize.w * effectiveScale : hole,
                    height: imgSize ? imgSize.h * effectiveScale : hole,
                    transform: [{ translateX: tx }, { translateY: ty }],
                  },
                ]}
                resizeMode="cover"
              />
            ) : (
              <View style={styles.placeholder}>
                <Text style={styles.placeholderText}>No image</Text>
              </View>
            )}

            {/* True outside-of-circle dimming (no "star" seams) */}
            <View pointerEvents="none" style={StyleSheet.absoluteFillObject}>
              {/* Top */}
              <View style={{ height: Math.max(0, side + O), backgroundColor: OUTSIDE }} />
              {/* Middle */}
              <View style={{ flexDirection: "row" }}>
                <View style={{ width: Math.max(0, side + O), height: hole, backgroundColor: OUTSIDE }} />

                <View style={{ width: hole, height: hole }}>
                  {/* 4 corner blocks with rounded inner corners; overlap by 1px to avoid seams */}
                  <View
                    style={[
                      styles.corner,
                      { left: -O, top: -O, width: q + O, height: q + O, borderBottomRightRadius: radius },
                    ]}
                  />
                  <View
                    style={[
                      styles.corner,
                      { right: -O, top: -O, width: q + O, height: q + O, borderBottomLeftRadius: radius },
                    ]}
                  />
                  <View
                    style={[
                      styles.corner,
                      { left: -O, bottom: -O, width: q + O, height: q + O, borderTopRightRadius: radius },
                    ]}
                  />
                  <View
                    style={[
                      styles.corner,
                      { right: -O, bottom: -O, width: q + O, height: q + O, borderTopLeftRadius: radius },
                    ]}
                  />

                  {/* Circle stroke */}
                  <View style={[styles.stroke, { width: hole, height: hole, borderRadius: radius }]} />
                </View>

                <View style={{ width: Math.max(0, side + O), height: hole, backgroundColor: OUTSIDE }} />
              </View>
              {/* Bottom */}
              <View style={{ flex: 1, backgroundColor: OUTSIDE }} />
            </View>
          </View>
        </View>

        <View style={styles.controls}>
          <TouchableOpacity style={styles.zoomBtn} onPress={() => zoomBy(-0.2)} activeOpacity={0.85}>
            <Text style={styles.zoomText}>−</Text>
          </TouchableOpacity>
          <Text style={styles.zoomLabel}>Zoom</Text>
          <TouchableOpacity style={styles.zoomBtn} onPress={() => zoomBy(+0.2)} activeOpacity={0.85}>
            <Text style={styles.zoomText}>+</Text>
          </TouchableOpacity>
        </View>

        <Text style={styles.hint}>Drag to position. Pinch to zoom, or use the buttons.</Text>
      </View>
    </Modal>
  );
}

const OUTSIDE = "rgba(0,0,0,0.35)";

const styles = StyleSheet.create({
  container: { flex: 1, backgroundColor: "#0B0F19" },
  header: {
    paddingTop: 14,
    paddingHorizontal: 14,
    paddingBottom: 10,
    flexDirection: "row",
    alignItems: "center",
    justifyContent: "space-between",
  },
  headerTitle: { color: "#FFFFFF", fontWeight: "900", fontSize: 16 },
  headerLink: { color: "#FFFFFF", fontWeight: "800", fontSize: 15 },

  editorWrap: { flex: 1, alignItems: "center", justifyContent: "center", padding: 16 },
  editor: {
    width: "100%",
    maxWidth: 340,
    aspectRatio: 1,
    borderRadius: 18,
    overflow: "hidden",
    backgroundColor: "#111827",
    alignItems: "center",
    justifyContent: "center",
  },
  image: { position: "absolute" },
  placeholder: { width: "100%", height: "100%", alignItems: "center", justifyContent: "center" },
  placeholderText: { color: "#9CA3AF", fontWeight: "800" },

  corner: { position: "absolute", backgroundColor: OUTSIDE },
  stroke: {
    position: "absolute",
    left: 0,
    top: 0,
    borderWidth: 2,
    borderColor: "rgba(255,255,255,0.9)",
  },

  controls: {
    paddingHorizontal: 16,
    paddingVertical: 12,
    flexDirection: "row",
    alignItems: "center",
    justifyContent: "center",
    gap: 14,
  },
  zoomBtn: {
    width: 44,
    height: 44,
    borderRadius: 22,
    backgroundColor: "rgba(255,255,255,0.12)",
    alignItems: "center",
    justifyContent: "center",
  },
  zoomText: { color: "#FFFFFF", fontWeight: "900", fontSize: 22, marginTop: -1 },
  zoomLabel: { color: "#E5E7EB", fontWeight: "800" },

  hint: {
    paddingHorizontal: 16,
    paddingBottom: 18,
    color: "#9CA3AF",
    fontSize: 12,
    lineHeight: 16,
    textAlign: "center",
  },
});
